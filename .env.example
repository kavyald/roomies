# Copy to .env.local (gitignored). Local values come from `pnpm supabase status`.

# Server only
# The app_server role (local password comes from supabase/seed.sql; hosted: the pooler URL)
DATABASE_URL=postgresql://app_server:app-server-local-only@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# One-time token for /setup/<token>; at least 32 characters (openssl rand -hex 24)
SETUP_TOKEN=
# Shared secret pg_cron sends to /api/cron/*; at least 32 characters (openssl rand -hex 24)
CRON_SECRET=

# Shipped to the browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
